include ./ops.mk
include ./caps.mk

VERSION=-v1-0.5.0
LEDGER_HOST=localhost
LEDGER_PORT=6865
JSON_API_PORT=7575
JSON_API=http://$(LEDGER_HOST):$(JSON_API_PORT)
PARTIES=RedStoneOracleOwner RedStoneOracleUpdater RedStoneOracleViewer Client Beneficiary
DAML=dpm
export PATH := $(HOME)/.dpm/bin:$(PATH)

TEST_DAR=.daml/dist/redstone-test$(VERSION).dar
CAPS_DARS=deps/caps-core-0.1.0.dar \
	deps/caps-verifier-redstone-0.1.1.dar \
	deps/caps-capsule-archiver-0.1.0.dar \
	deps/caps-round-archiver-0.1.0.dar \
	caps-oracle/.daml/dist/caps-redstone-oracle-0.1.1.dar

.PHONY: get_party_suffix

build-%:
	cd $(DEPLOY_DIR)/$* && $(DAML) build

clean-%:
	cd $(DEPLOY_DIR)/$* && $(DAML) clean

build_redstone_core: build-common build-sdk build-interface build-core

build_test:
	cd $(DEPLOY_DIR) && $(DAML) build --all

run-%: build_test
	cd $(DEPLOY_DIR)/test && $(DAML) script --ide-ledger \
		--dar $(TEST_DAR) \
		--script-name $*:main \
		--input-file input.json

clean:
	cd $(DEPLOY_DIR) && $(DAML) clean --all
	rm -f $(ADAPTER_ID_TXT) $(CORE_ID_TXT) refresh_token.txt token.txt $(DEPLOY_DIR)/test/input.json $(DEPLOY_DIR)/test/sample_data/payload.hex

lint: lint-common lint-types lint-sdk lint-sdk-tests lint-core lint-interface lint-featured lint-reward_factory lint-caps-oracle lint-caps-test lint-test
	./scripts/lint-whitespaces.sh
	./scripts/lint-exposed-modules.sh $(DEPLOY_DIR)

build: build_test

lint-%:
	cd $(DEPLOY_DIR)/$* && $(DAML) damlc lint

run_main: run-Main

run_test: build_test lint-test run-Core

test-%: build_redstone_core build_test
	cd $(DEPLOY_DIR)/test && $(DAML) script --ide-ledger \
		--dar $(TEST_DAR) \
		--script-name $*:main

caps-test: build_test
	cd $(DEPLOY_DIR)/caps-test && $(DAML) test --test-pattern test

caps-start: build_test
	cd $(DEPLOY_DIR) && $(DAML) sandbox \
	--ledger-api-port $(LEDGER_PORT) \
	--json-api-port $(JSON_API_PORT) \
	$(addprefix --dar ,$(CAPS_DARS))

test: test-UnitTests caps-test

integration_tests: prepare_data run_main run_test

ledger-%: build_test
	cd $(DEPLOY_DIR)/test && $(DAML) script --script-name $*:main \
	--ledger-host $(LEDGER_HOST) \
	--ledger-port $(LEDGER_PORT) \
	--input-file input.json \
	--dar $(TEST_DAR)

start: build_test
	cd $(DEPLOY_DIR)/test && $(DAML) sandbox \
	--ledger-api-port $(LEDGER_PORT) \
	--json-api-port $(JSON_API_PORT) \
	--dar $(TEST_DAR)

start_daemon:
	make start & \
	sleep 20

start_caps_daemon:
	make caps-start & \
	sleep 20

ledger_upload: build
	curl -sf -X POST "$(JSON_API)/v2/packages" \
	-H "Content-Type: application/octet-stream" \
	--data-binary @$(DEPLOY_DIR)/test/$(TEST_DAR)

ledger_deploy: build ledger-Deploy

ledger_tests: allocate_parties get_party_suffix ledger_deploy
start_local: start_daemon allocate_parties get_party_suffix ledger_deploy

allocate_parties:
	@for party in $(PARTIES); do \
	curl -sf -X POST "$(JSON_API)/v2/parties" \
	-H "Content-Type: application/json" \
	-d "{\"partyIdHint\": \"$$party\", \"identityProviderId\": \"\"}" || exit 1; \
	done

list_parties:
	@curl -sf "$(JSON_API)/v2/parties"

get_party_suffix:
	@HASH=$$(make list_parties | grep -o '[a-f0-9]\{68\}' | head -1); \
	if [[ "$$(uname)" == "Darwin" ]]; then \
		sed -i '' "s/::[a-f0-9]\{68\}/::$$HASH/g" $(DEPLOY_DIR)/test/input.json; \
		sed -i '' "s/::[a-f0-9]\{68\}/::$$HASH/g" $(DEPLOY_DIR)/test/input.json.input; \
	else \
		sed -i "s/::[a-f0-9]\{68\}/::$$HASH/g" $(DEPLOY_DIR)/test/input.json; \
		sed -i "s/::[a-f0-9]\{68\}/::$$HASH/g" $(DEPLOY_DIR)/test/input.json.input; \
	fi

codegen:
	curl http://localhost:7575/docs/openapi -o ./src/_autogenerated/openapi.yaml
	npx openapi-typescript-codegen --input ./src/_autogenerated/openapi.yaml --output ./src/_autogenerated --client axios

generate-package-ids:
	cd $(DEPLOY_DIR) && $(DAML) clean --all && $(DAML) build --all
	(cd $(DEPLOY_DIR) && bash $(abspath scripts/generate-package-ids.sh)) > $(DEPLOY_DIR)/package-ids.json
	@echo "Written to $(DEPLOY_DIR)/package-ids.json" >&2
	@cat $(DEPLOY_DIR)/package-ids.json

verify-package-ids:
	@echo "Verifying $(DEPLOY_DIR)/package-ids.json is up-to-date..."
	cd $(DEPLOY_DIR) && $(DAML) build --all
	@TMPFILE=$$(mktemp); \
	(cd $(DEPLOY_DIR) && bash $(abspath scripts/generate-package-ids.sh)) > "$$TMPFILE" 2>/dev/null; \
	if diff -q $(DEPLOY_DIR)/package-ids.json "$$TMPFILE" > /dev/null 2>&1; then \
		echo "$(DEPLOY_DIR)/package-ids.json is up-to-date"; \
		rm -f "$$TMPFILE"; \
	else \
		echo "ERROR: $(DEPLOY_DIR)/package-ids.json is out of date. Diff:"; \
		diff $(DEPLOY_DIR)/package-ids.json "$$TMPFILE" || true; \
		rm -f "$$TMPFILE"; \
		exit 1; \
	fi
