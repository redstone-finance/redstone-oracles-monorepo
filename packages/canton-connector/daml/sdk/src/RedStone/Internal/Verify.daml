module RedStone.Internal.Verify
    (
        verificationError
        , verifyTimestamps
    ) where

import DA.List as L
import RedStone.Error
import RedStone.Result (Result(..))
import RedStone.Internal.Flow

-- Public

verificationError = RedStoneError Verification

verifyTimestamps config dataPackages =
    let ts = dedup $ map (\dataPackage -> dataPackage.timestamp) dataPackages
    in not (L.null ts) ??? verificationError "No timestamps in payload" ts
    ?> verifyTimestampWindow config ts

-- Private

verifyTimestampWindow config [timestamp] =
    timestamp <= config.currentTimestamp + config.maxAllowedPackageTimestampAheadMs ??? verificationError "Timestamp too far in the future" (timestamp, config.currentTimestamp + config.maxAllowedPackageTimestampAheadMs)
    ?> timestamp >= config.currentTimestamp - config.maxAllowedPackageTimestampDelayMs ??? verificationError "Timestamp too old" (timestamp, config.currentTimestamp - config.maxAllowedPackageTimestampDelayMs)
    ?> Ok timestamp
verifyTimestampWindow _ ts = Error $ verificationError "Timestamps are non-equal" $ show ts
