module RedStone.Internal.Trim
  (
    trimStart
    , trimMulti
    , trimLeadingZeros
    , trimTrailingZeros
  ) where

import DA.List as L
import RedStone.Error
import RedStone.Result (Result(..))
import RedStone.Internal.Flow

-- Public

trimLeadingZeros = L.dropWhile (== 0)
trimTrailingZeros = L.dropWhileEnd (== 0)

trimStart = trimMulti trimOneElement

trimMulti _ n _ | n < 0 =
  Error $ RedStoneError Parse "Negative trim length" $ show n
trimMulti trimSingle n list = trimMultiAcc [] trimSingle n list

-- Private

trimMultiAcc acc trimSingle n list = case n of
  0 -> Ok (list, acc)
  _ ->
    trimSingle list
    >?> \(rest, trimmed) -> trimMultiAcc (trimmed :: acc) trimSingle (n - 1) rest

trimOneElement [] = Error $ RedStoneError Parse "List too short" $ show ([] : [Int])
trimOneElement (h :: t) = Ok (t, h)
