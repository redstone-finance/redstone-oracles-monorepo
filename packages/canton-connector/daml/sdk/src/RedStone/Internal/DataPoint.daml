module RedStone.Internal.DataPoint where

import RedStone.U256
import RedStone.Internal.Bytes as B
import RedStone.Internal.Flow
import RedStone.Internal.Protocol
import RedStone.Internal.Trim

-- Public

data DataPoint = DataPoint
  with
    feedId : [Int]
    value : U256
  deriving (Eq, Show)

trimDataPoint valueSize bytes =
  bytesTrim valueSize bytes
  >?> \(valueRest, value) -> bytesTrim feed_id_bs valueRest
  >? \(feedIdRest, feedId) -> (feedIdRest, DataPoint (trimTrailingZeros feedId) (u256FromBeByteList value))
