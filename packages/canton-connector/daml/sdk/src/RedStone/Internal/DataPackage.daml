module RedStone.Internal.DataPackage
  (
    DataPackage(..)
    , trimDataPackage
  ) where

import RedStone.Error
import RedStone.Result (Result(Ok))
import RedStone.Internal.Bytes
import RedStone.Internal.Const
import RedStone.Internal.DataPoint
import RedStone.Internal.Flow
import RedStone.Internal.Hex
import RedStone.Internal.Protocol
import RedStone.Internal.Trim

-- Public

data DataPackage = DataPackage
  with
    dataPoints : [DataPoint]
    timestamp : Int
    valueSize : Int
    signature : HexBytes
    signableBytes : HexBytes
  deriving (Eq, Show)

trimDataPackage bytes =
  bytesTrim signature_bs bytes
  >?> \(signatureRest, signature) -> bytesTrimNum data_point_count_bs signatureRest
  >?> \(dataPointCountRest, dataPointCount) -> trimValueSize dataPointCountRest
  >?> \(valueSizeRest, valueSize) -> bytesTrimNum timestamp_bs valueSizeRest
  >?> \(timestampRest, timestamp) -> bytesTrim (signableSize dataPointCount valueSize) signatureRest
  >?> \(_, signableBytes) -> trimMulti (trimDataPoint valueSize) dataPointCount timestampRest
  >? \(dataPointsRest, dataPoints) -> (dataPointsRest, DataPackage dataPoints timestamp valueSize (HexBytes signature) (HexBytes signableBytes))

-- Private

trimValueSize bytes =
  bytesTrimNum value_size_bs bytes
  >?> \(valueSizeRest, valueSize) -> valueSize <= uint256_size_bytes ??? RedStoneError Verification "Value byte size over 32" valueSize
  ?> Ok (valueSizeRest, valueSize)

signableSize dataPointCount valueSize =
    dataPointCount * (valueSize + feed_id_bs) + value_size_bs
        + timestamp_bs + data_point_count_bs
