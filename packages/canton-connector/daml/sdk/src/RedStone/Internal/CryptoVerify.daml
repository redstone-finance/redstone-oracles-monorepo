module RedStone.Internal.CryptoVerify
(
  getSignerIndex
) where

import DA.Crypto.Text as C
import DA.List as L
import RedStone.Error
import RedStone.Result
import RedStone.Internal.Hex

-- Public

getSignerIndex publicKeysDer signatureDer dataPackage =
    let
        index = L.findIndex (isValidSig signatureDer dataPackage.signableBytes) publicKeysDer
    in resultFromOptional (RedStoneError Processing "Wrong signer index" $ show dataPackage) index

-- Private

isValidSig signatureDer HexBytes{bytes=signableBytes} =
  C.secp256k1WithEcdsaOnly signatureDer $ C.keccak256 $ listToHex signableBytes
