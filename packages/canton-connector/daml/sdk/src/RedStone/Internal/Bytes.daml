module RedStone.Internal.Bytes where

import DA.List as L
import RedStone.Internal.Flow
import RedStone.Internal.Math
import RedStone.Internal.Trim

-- Public

data Bytes = Bytes
  with
    revList : [Int]
  deriving (Eq, Show)

fromList list = Bytes $ L.reverse list

bytesTrim n Bytes{revList} =
    trimStart n revList
    >? \(rest, trimmed) -> (Bytes rest, trimmed)

bytesTrimNum n bytes =
    bytesTrim n bytes
    >? \(rest, trimmed) -> (rest, beByteListToInt trimmed)
