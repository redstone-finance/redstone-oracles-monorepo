module RedStone.Internal.Protocol
  (
    signature_bs
    , data_point_count_bs
    , value_size_bs
    , timestamp_bs
    , feed_id_bs
    , redstone_marker_size
    , redstone_marker
    , uns_metadata_count_bs
    , data_packages_bs
    , decimals
    , trimMetadata
    , verifyPayloadHex
  ) where

import DA.Crypto.Text as C
import DA.Text as T
import RedStone.Error
import RedStone.Result (Result(Ok))
import RedStone.Internal.Bytes as B
import RedStone.Internal.Const
import RedStone.Internal.Flow

-- Public

signature_bs = 65
data_point_count_bs = 3
value_size_bs = 4
timestamp_bs = 6
feed_id_bs = 32
redstone_marker_size = 9
redstone_marker = [0,0,2,237,87,1,30,0,0]
uns_metadata_count_bs = 3
data_packages_bs = 2
decimals = 8


trimMetadata bytes =
  trimMarker bytes
  >?> trimUnsignedMetadata

verifyPayloadHex hex =
  T.length hex <= max_payload_hex_chars ??? RedStoneError Parse "Payload too large" (T.length hex, max_payload_hex_chars)
  >?> \_ -> C.isHex hex && T.length hex % 2 == 0 ??? RedStoneError Parse "Payload is not a valid hex string" hex
  ?> Ok hex

-- Private

trimMarker bytes =
  bytesTrim redstone_marker_size bytes
  >?> \(markerRest, marker) -> marker == redstone_marker ??? RedStoneError Parse "Wrong RedStone marker" marker
  ?> Ok markerRest

trimUnsignedMetadata bytes =
  bytesTrimNum uns_metadata_count_bs bytes
  >?> \(unsMetadataByteCountRest, unsignedMetadataByteCount) -> bytesTrim unsignedMetadataByteCount unsMetadataByteCountRest
  >?> \(unsMetadataRest, _) -> bytesTrimNum data_packages_bs unsMetadataRest
