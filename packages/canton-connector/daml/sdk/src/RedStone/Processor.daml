module RedStone.Processor
 (
  processPayload
  , processPayloadNumeric
  -- Exposed for testing — pure helpers of the aggregation pipeline.
  , buildMatrixInput
 ) where

import DA.List as L
import DA.Map as M
import DA.Optional
import DA.Set as S
import RedStone.Config
import RedStone.Error
import RedStone.ProcessorTypes
import RedStone.Result
import RedStone.U256
import RedStone.Internal.Bytes as B
import RedStone.Internal.CryptoVerify
import RedStone.Internal.DataPackage
import RedStone.Internal.DataPoint(DataPoint(..))
import RedStone.Internal.Der
import RedStone.Internal.Flow
import RedStone.Internal.Hex
import RedStone.Internal.Median
import RedStone.Internal.Protocol
import RedStone.Internal.Trim
import RedStone.Internal.Verify

-- Public

processPayload config hex =
  verifyPayloadHex hex
  >? B.fromList . hexToList
  >?> processPayloadBytes config

processPayloadNumeric: Config -> Text -> Result ProcessorOutcome (RedStoneError Text)
processPayloadNumeric config hex =
  processPayload config hex
  >? \(values, timestamp) -> (map (>? u256ToDecimalValue) values, timestamp)

buildMatrixInput dataPointsWithSignerIndices =
  let
    step acc (_, Error _) = acc
    step (matrix, conflicts) (DataPoint{feedId, value}, index) =
      let key = (feedId, index)
      in case M.lookup key matrix of
        None -> (M.insert key value matrix, conflicts)
        Some existing
          | existing == value -> (matrix, conflicts)
          | otherwise -> (matrix, S.insert feedId conflicts)
  in L.foldl step (M.empty, S.empty) dataPointsWithSignerIndices

-- Private

processPayloadBytes config bytes =
  trimMetadata bytes
  >?> \(dataPackageCountRest, dataPackageCount) -> trimDataPackages dataPackageCount dataPackageCountRest
  >?> \dataPackages -> verifyTimestamps config dataPackages
  >? \timestamp -> (aggregate $ getFeedValues config dataPackages, timestamp)

trimDataPackages dataPackageCount bytes =
  trimMulti trimDataPackage dataPackageCount bytes
  >?> \(Bytes{revList=dataPackagesRest}, dataPackages) -> L.null dataPackagesRest ??? RedStoneError Parse "Non-empty payload remainder" (L.reverse dataPackagesRest)
  ?> Ok dataPackages

aggregate = map (>? median)

getFeedValues config dataPackages =
  let
    seqlt n = [0..(n-1)]
    dataPointsWithSignerIndices = getDataPointsWithSignerIndices $ map (withSignerIndex config.signers) dataPackages
    makeMatrix input = map (\feedId -> map (\signerIndex -> M.lookup (feedId, Ok signerIndex) input) (seqlt $ L.length config.signers)) config.feedIds
    (matrixInput, conflictedFeeds) = buildMatrixInput dataPointsWithSignerIndices
    feedValues = map catOptionals $ makeMatrix matrixInput

    classify (feedId, values)
      | S.member feedId conflictedFeeds = Error $ RedStoneError Processing "Same signer submitted conflicting values for feed" $ show $ map Some values
      | L.length values < config.signerCountThreshold = Error $ RedStoneError Processing "Signer count not achieved" $ show $ map Some values
      | otherwise = Ok values
  in zipWith (curry classify) config.feedIds feedValues

getDataPointsWithSignerIndices dataPackageSignerIndices =
  let
    dataPointsWithSignerIndices = concatMap (\(dataPackage, signIndex) -> map (\(dataPoint) -> (dataPoint, signIndex)) dataPackage.dataPoints) dataPackageSignerIndices
  in L.filter (\(dataPoint, _) -> isNotZero dataPoint.value) dataPointsWithSignerIndices

withSignerIndex publicKeysDer dataPackage =
  ( dataPackage
  , signatureToDer dataPackage.signature.bytes
    >?> \signatureDer -> getSignerIndex publicKeysDer (listToHex signatureDer) dataPackage
  )
