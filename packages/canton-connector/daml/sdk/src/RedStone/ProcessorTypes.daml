module RedStone.ProcessorTypes
  (
    DecimalValue
    , value_divisor
    , ProcessorOutcome
    , ProcessorRawOutcome
    , ProcessorPackagesOutcome
    , ProcessorRawPackagesOutcome
  ) where

import RedStone.Error
import RedStone.Result
import RedStone.SignedDataPackage (SignedDataPackage)
import RedStone.U256

-- Public

-- The max value of Numeric 0 is 10^38-1, but the RedStone value is given as multiplied by 10^8,
-- so that's 10^30-1 for the real value, which means only the decimal values up to 2^99 (2^126 as multiplied) are supported by the DecimalValue
type DecimalValue = Numeric 8 -- 8 decimals
value_divisor: DecimalValue = 10.0 ^ 8

type ProcessorOutcome  = ([Result DecimalValue (RedStoneError Text)], Int)
type ProcessorRawOutcome = ([Result U256 (RedStoneError Text)], Int)
type ProcessorPackagesOutcome = ([Result [SignedDataPackage DecimalValue] (RedStoneError Text)], Int)
type ProcessorRawPackagesOutcome = ([Result [SignedDataPackage U256] (RedStoneError Text)], Int)
