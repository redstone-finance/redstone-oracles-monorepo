module RedStone.Config
  (
    Config
    , BaseConfig(..)
    , PublicKey
    , config
    , verifyConfigAgainstLedger
  ) where

import DA.Assert
import DA.List as L
import DA.Time
import Time
import RedStone.Error
import RedStone.Result (Result(Ok))
import RedStone.Internal.Const
import RedStone.Internal.Der (publicKeyToDer)
import RedStone.Internal.Flow
import RedStone.Internal.Protocol(feed_id_bs)

-- Public

type PublicKey = Text

data BaseConfig = BaseConfig
  with
    signers : [PublicKey]
    signerCountThreshold : Int
    maxAllowedPackageTimestampDelayMs : Int
    maxAllowedPackageTimestampAheadMs : Int
  deriving (Eq, Show)

data Config = Config
  with
    feedIds : [[Int]]
    currentTimestamp : Int
    signers : [PublicKey]
    signerCountThreshold : Int
    maxAllowedPackageTimestampDelayMs : Int
    maxAllowedPackageTimestampAheadMs : Int
  deriving (Eq, Show)

config baseConfig feedIds currentTime =
  let
    BaseConfig{signers, signerCountThreshold, maxAllowedPackageTimestampDelayMs, maxAllowedPackageTimestampAheadMs} = baseConfig
    currentTimestamp = timeToMillis currentTime
  in verifyFeedIds feedIds
  ?> verifySigners signers signerCountThreshold
  >?> \signersDer -> verifyTimeLimits maxAllowedPackageTimestampAheadMs maxAllowedPackageTimestampDelayMs currentTimestamp
  ?> Ok Config{feedIds, currentTimestamp, signers = signersDer, signerCountThreshold, maxAllowedPackageTimestampDelayMs, maxAllowedPackageTimestampAheadMs}

verifyConfigAgainstLedger config = verifyCurrentTimeVsLedger config

-- Private

configError = RedStoneError Configuration

verifyFeedIds feedIds =
  unique feedIds && feedIds /= [] ??? configError "feedIds are empty or not unique" feedIds
  ?> L.length feedIds <= max_feed_ids ??? configError "Too many feedIds" (L.length feedIds, max_feed_ids)
  ?> L.all isValidFeedId feedIds ??? configError "Malformed feedId (length out of range or byte out of range)" feedIds

isValidFeedId feedId =
  not (null feedId) && L.length feedId <= feed_id_bs && L.all (\b -> b >= 0 && b <= byte_max) feedId

verifySigners signers signerCountThreshold =
  traverseResult publicKeyToDer signers
  >?> \signersDer -> unique signersDer && signersDer /= [] ??? configError "signers are empty or not unique" signersDer
  ?> signerCountThreshold <= L.length signersDer ??? configError "signerCountThreshold exceeds signer length" (signerCountThreshold, L.length signersDer)
  ?> signerCountThreshold > 0 ??? configError "signerCountThreshold must be positive" signerCountThreshold
  ?> Ok signersDer

verifyTimeLimits maxAllowedPackageTimestampAheadMs maxAllowedPackageTimestampDelayMs currentTimestamp =
  maxAllowedPackageTimestampAheadMs >= 0 ??? configError "maxAllowedPackageTimestampAheadMs must be non-negative" maxAllowedPackageTimestampAheadMs
  ?> maxAllowedPackageTimestampDelayMs >= 0 ??? configError "maxAllowedPackageTimestampDelayMs must be non-negative" maxAllowedPackageTimestampDelayMs
  ?> currentTimestamp > min_acceptable_timestamp ??? configError "Wrong currentTimestamp" currentTimestamp

verifyCurrentTimeVsLedger config = do
  hasLedger <- hasLedgerTime
  if hasLedger then do
    let currentTime = millisToTime config.currentTimestamp

    let maxLedgerFutureTime = addRelTime currentTime $ milliseconds $ negate config.maxAllowedPackageTimestampAheadMs
    let maxLedgerOldTime = addRelTime currentTime $ milliseconds config.maxAllowedPackageTimestampDelayMs

    assertWithinDeadline  "currentTimestamp too old"  maxLedgerOldTime  --- ledgerTime - maxAllowedPackageTimestampDelayMs < currentTime
    assertDeadlineExceeded  "currentTimestamp too future"  maxLedgerFutureTime --- ledgerTime + maxAllowedPackageTimestampAheadMs >= currentTime

    pure config
  else pure config

hasLedgerTime = isLedgerTimeGT unix_epoch_start
