module Main where

import Daml.Script
import RedStone.PrimaryProdConfig
import RedStone.Processor
import RedStone.Result (resultUnwrap)
import Input

main : Input -> Script ()
main input = script do

currentTime <- getTime

let config = (resultUnwrap $ redstonePrimaryProdDefaultConfig input.feedIds currentTime) with maxAllowedPackageTimestampDelayMs = 30 * 60_000

let resultNumeric = processPayloadNumeric config input.payload
let result = processPayload config input.payload

debug resultNumeric
debug result
