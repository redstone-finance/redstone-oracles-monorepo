{
  "name": "@redstone-finance/solana-connector",
  "version": "0.9.0",
  "description": "A tool to inject RedStone data into Solana compatible smart contracts",
  "main": "dist/src/index.js",
  "exports": "./dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "MIT",
  "scripts": {
    "clean": "yarn global:ts-clean",
    "build": "yarn global:tsc -p tsconfig.build.json",
    "build:turbo": "yarn global:turbo build",
    "typecheck": "yarn global:tsc --noEmit",
    "typecheck:turbo": "yarn global:turbo typecheck",
    "lint": "yarn global:eslint .",
    "lint:fix": "yarn global:eslint --fix .",
    "test": "yarn global:jest:cov --runInBand",
    "preversion": "yarn build",
    "pack-package": "yarn build && cd dist && npm pack",
    "sample-run": "yarn build:turbo && yarn global:with-auth-gateways node dist/scripts/sample-run.js",
    "write-simultaneously": "yarn global:with-auth-gateways yarn global:tsx scripts/write-simultaneously.ts",
    "anchor-deploy": "yarn global:tsx scripts/anchor-deploy.ts",
    "verify-program": "yarn global:tsx scripts/verify-program.ts",
    "verify-program-as-multi-sig": "yarn global:tsx scripts/ledger/verify-program-as-multi-sig.ts",
    "run-node": "echo todo",
    "create-multi-sig": "yarn global:tsx scripts/ledger/create-multi-sig.ts",
    "set-authority": "yarn global:tsx scripts/ledger/set-authority.ts",
    "set-authority-as-ledger": "yarn global:tsx scripts/ledger/set-authority-as-ledger.ts",
    "gov-as-multi-sig": "yarn global:tsx scripts/ledger/gov-as-multi-sig.ts",
    "ledger-get-public-key": "yarn global:tsx scripts/ledger/ledger-get-public-key.ts",
    "convert-public-key": "yarn global:tsx scripts/convert-public-key.ts",
    "transfer-sol": "yarn global:tsx scripts/transfer-sol.ts",
    "make-feed-table": "yarn global:tsx scripts/make-feed-table.ts",
    "show-multi-sig-tx-details": "yarn global:tsx scripts/ledger/show-multi-sig-tx-details.ts",
    "write-buffer": "yarn global:tsx scripts/write-program-buffer.ts",
    "update-metadata-authority": "yarn global:tsx scripts/update-metadata-authority.ts",
    "add-multi-sig-members": "yarn global:tsx scripts/ledger/add-multi-sig-members.ts",
    "manage-limits": "yarn global:tsx scripts/ledger/manage-limits.ts",
    "remove-multi-sig-members": "yarn global:tsx scripts/ledger/remove-multi-sig-members.ts",
    "execute-config-tx": "yarn global:tsx scripts/ledger/execute-config-tx.ts",
    "check-deployed-buffer": "yarn global:tsx scripts/check-deployed-bytecode.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@redstone-finance/multichain-kit": "workspace:*",
    "@redstone-finance/protocol": "workspace:*",
    "@redstone-finance/sdk": "workspace:*",
    "@redstone-finance/solana-connection": "workspace:*",
    "@redstone-finance/utils": "workspace:*",
    "@solana/web3.js": "^1.98.4",
    "jito-js-rpc": "^0.2.2",
    "lodash": "^4.17.23",
    "zod": "^4.1.12"
  },
  "resolutions": {
    "form-data@npm:4.0.0": "^4.0.6"
  },
  "files": [
    "dist/src/**/*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
