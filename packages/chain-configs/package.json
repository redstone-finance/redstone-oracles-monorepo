{
  "name": "@redstone-finance/chain-configs",
  "version": "0.9.0",
  "main": "dist/src/index.js",
  "exports": "./dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "MIT",
  "scripts": {
    "clean": "yarn global:ts-clean",
    "build": "yarn global:tsc -p tsconfig.build.json",
    "build:turbo": "yarn global:turbo build",
    "typecheck": "yarn global:tsc --noEmit",
    "typecheck:turbo": "yarn global:turbo typecheck",
    "lint": "yarn global:eslint . && yarn global:prettier --check manifest/**/*.json",
    "lint:fix": "yarn global:eslint --fix . && yarn global:prettier --write manifest/**/*.json",
    "preversion": "yarn build",
    "print:chain-configs": "yarn global:tsx scripts/print-chain-configs.ts",
    "print:ssm-rpc-urls-dev": "ENV=dev yarn global:tsx scripts/print-ssm-rpc-urls.ts",
    "print:ssm-rpc-urls-prod": "ENV=prod yarn global:tsx scripts/print-ssm-rpc-urls.ts",
    "compare:ssm-rpc-urls-prod": "ENV=prod yarn global:tsx scripts/compare-ssm-rpc-urls.ts",
    "compare:ssm-rpc-urls-dev": "ENV=dev yarn global:tsx scripts/compare-ssm-rpc-urls.ts",
    "test": "mocha 'test/**/*.test.ts'",
    "test:rpc-urls-dev-all": "ENV=dev TEST_RPC=T mocha test/rpc-urls/ssm-rpc-urls.test.ts",
    "test:rpc-urls-dev-specific": "ENV=dev TEST_RPC=T NETWORK_ID=${NETWORK_ID} mocha test/rpc-urls/ssm-rpc-urls.test.ts",
    "test:rpc-urls-prod-all": "ENV=prod TEST_RPC=T mocha test/rpc-urls/ssm-rpc-urls.test.ts",
    "test:rpc-urls-prod-specific": "ENV=prod TEST_RPC=T NETWORK_ID=${NETWORK_ID} mocha test/rpc-urls/ssm-rpc-urls.test.ts",
    "test:chain-configs": "mocha test/chain-configs.test.ts"
  },
  "dependencies": {
    "@ethersproject/contracts": "^5.7.0",
    "@ethersproject/providers": "^5.6.8",
    "@ethersproject/wallet": "^5.7.0",
    "@redstone-finance/evm-multicall": "workspace:*",
    "@redstone-finance/internal-utils": "workspace:*",
    "@redstone-finance/remote-config": "workspace:*",
    "@redstone-finance/utils": "workspace:*",
    "dayjs": "^1.11.12",
    "lodash": "^4.17.23",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/chai": "^4.3.4",
    "chai": "^4.3.10",
    "chalk": "^4.1.2",
    "dotenv": "^16.0.3",
    "mocha": "^11"
  },
  "overrides": {
    "elliptic": "^6.6.1"
  },
  "resolutions": {
    "elliptic": "^6.6.1"
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
