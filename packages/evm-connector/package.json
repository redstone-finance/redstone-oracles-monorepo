{
  "name": "@redstone-finance/evm-connector",
  "version": "1.0.0",
  "description": "A tool to inject RedStone data into EVM compatible smart contracts",
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./contracts/*": "./contracts/*"
  },
  "license": "MIT",
  "scripts": {
    "clean": "yarn global:ts-hardhat-clean",
    "build": " yarn global:tsc -p tsconfig.build.json",
    "build:turbo": "yarn global:turbo build",
    "typecheck": "yarn global:tsc --noEmit",
    "typecheck:turbo": "yarn global:turbo typecheck",
    "compile": "hardhat compile",
    "lint": "yarn global:eslint . && solhint 'contracts/**/*.sol'",
    "lint:fix": "yarn global:eslint --fix .",
    "test": "hardhat test --gas-stats",
    "test-e2e": "yarn global:with-auth-gateways hardhat test test-e2e/data-service-wrapper.e2e.test.ts",
    "benchmark": "hardhat test benchmarks/run-benchmarks.ts"
  },
  "dependencies": {
    "@ethersproject/abi": "^5.6.3",
    "@ethersproject/abstract-provider": "^5.7.0",
    "@ethersproject/abstract-signer": "^5.7.0",
    "@ethersproject/contracts": "^5.7.0",
    "@ethersproject/properties": "^5.7.0",
    "@openzeppelin/contracts": "^4.8.1",
    "@redstone-finance/protocol": "workspace:*",
    "@redstone-finance/sdk": "workspace:*",
    "@redstone-finance/signing": "workspace:*",
    "@redstone-finance/utils": "workspace:*"
  },
  "devDependencies": {
    "@ethersproject/bignumber": "^5.7.0",
    "@ethersproject/providers": "^5.6.8",
    "@nomicfoundation/hardhat-mocha": "^3.0.21",
    "@openzeppelin/contracts-upgradeable": "^4.8.3",
    "@types/chai": "^4.3.4",
    "@types/chai-as-promised": "^7.1.5",
    "@types/mocha": "^10.0.10",
    "chai": "^4.3.10",
    "chai-as-promised": "^7.1.1",
    "hardhat": "^3.13.0",
    "mocha": "^11",
    "msw": "^2.4.10",
    "solhint": "^5.0.5"
  },
  "files": [
    "src",
    "dist",
    "contracts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module"
}
