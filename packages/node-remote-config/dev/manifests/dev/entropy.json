{
  "interval": 1000,
  "priceAggregator": "median",
  "defaultSource": ["coingecko"],
  "sourceTimeout": 8000,
  "minValidSourcesPercentage": 1,
  "deviationCheck": {
    "deviationWithRecentValues": {
      "maxPercent": 1000000000,
      "maxDelayMilliseconds": 1000
    }
  },
  "defaultBroadcasters": ["redstone-packages", "influx"],
  "tokens": {
    "OPENAI_PERP": {
      "source": ["ws-perp-binance-usdt", "ws-perp-coinbase-usdc", "ws-perp-mexc-usdt"],
      "priceAggregator": "geomean",
      "geomeanAggregatorConfig": {
        "medianClamps": 25
      },
      "denomination": "USD",
      "rateFeed": false
    },
    "OPENAI_SECONDARIES": {
      "source": ["notice", "hiive"],
      "priceAggregator": "geomean",
      "geomeanAggregatorConfig": {
        "medianClamps": 25
      },
      "denomination": "USD",
      "rateFeed": false
    },
    "OPENAI_PRESTOCKS": {
      "source": ["jupiter", "dex-screener"],
      "priceAggregator": "primarySource",
