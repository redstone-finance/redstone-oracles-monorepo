{
  "interval": 1000,
  "priceAggregator": "median",
  "defaultSource": [
    "coingecko"
  ],
  "sourceTimeout": 8000,
  "minValidSourcesPercentage": 1,
  "deviationCheck": {
    "deviationWithRecentValues": {
      "maxPercent": 1000000000,
      "maxDelayMilliseconds": 1000
    }
  },
  "defaultBroadcasters": [
    "redstone-packages",
    "influx"
  ],
  "tokens": {
    "USDT": {
      "source": [
        "bitstamp-usd",
        "coinbase-usd",
        "gemini-usd",
        "kraken-usd",
        "okx-usd"
      ],
      "deviationCheck": {
        "deviationWithRecentValues": {
          "maxPercent": 5,
          "maxDelayMilliseconds": 120000
        }
      },
      "denomination": "USD",
      "rateFeed": false,
      "broadcasters": [
        "influx",
        "s3"
      ]
    },
    "USDC": {
